# ------------- app settings -------------
APP_NAME="python-fastapi-boilerplate"
APP_DESCRIPTION="A fully Async FastAPI boilerplate"
APP_VERSION="0.1.0"
CONTACT_NAME="Nishant Bhagat"
CONTACT_EMAIL="nishantbhagat435@gmail.com"
